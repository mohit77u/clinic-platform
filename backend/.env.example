PORT=3001
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=change_me
DB_PASSWORD=change_me
DB_NAME=clinic_platform
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-min-32-chars
JWT_REFRESH_SECRET=change-me-min-32-chars
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000
# Payments (leave empty in dev: a built-in test gateway is used)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Seller details printed on invoices
COMPANY_NAME=Clinic Platform
COMPANY_GSTIN=GSTIN-PENDING
COMPANY_ADDRESS=Rewa, Madhya Pradesh
COMPANY_STATE=Madhya Pradesh
PRIVATE_DIR=private
# Notifications: "console" prints WhatsApp messages (and OTPs) to the terminal (dev only).
# "live" sends through the WhatsApp BSP; REQUIRED in production.
NOTIFIER=console
WHATSAPP_API_KEY=
RATE_LIMIT_PER_MIN=300
TRUST_PROXY=false
SENTRY_DSN=
